# ujiscan Environment Variables (SECRETS - JANGAN COMMIT)
# Copy file ini ke .env dan isi dengan API key asli
# File .env sudah ada di .gitignore

# AI Provider API Keys untuk Full Scan AI
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-claude-key-here

# Database (optional override)
# DATABASE_PATH=/app/data/ujiscan.db

# Logging
# LOG_LEVEL=info
